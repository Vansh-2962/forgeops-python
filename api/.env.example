APP_NAME=GitHub AI Agent
ENVIRONMENT=development
GITHUB_API_URL=https://api.github.com
# GitHub OAuth App settings; callback URL must match the registered app URL.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/github/callback
GROQ_API_KEY=replace-with-a-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/forgeops
FRONTEND_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/auth/google/callback
SESSION_COOKIE_NAME=forgeops_session
SESSION_MAX_AGE_DAYS=14
SESSION_COOKIE_SECURE=false